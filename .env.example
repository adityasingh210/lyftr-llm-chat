# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Comma-separated key pool (>= 2). Ids are assigned in order: key_1, key_2, ...
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model used by every key (e.g. gemini/gemini-3.5-flash-lite, groq/llama-3.1-8b-instant).
# Use mock/demo to run fully offline without real keys.
# NOTE: Gemini quotas are per Google Cloud *project*, not per key. Create each key in a different
# project (or mix providers with LLM_KEY_MODELS), otherwise a real 429 hits every key at once.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: one model per key, aligned with LLM_API_KEYS (pool spanning several models/providers).
LLM_KEY_MODELS=
# Optional custom endpoint for every key (LiteLLM proxy, OpenAI-compatible host, ...).
LLM_API_BASE=
# Optional extra LiteLLM params as JSON; part of the cache key. e.g. {"temperature": 0.3}
LLM_EXTRA_PARAMS=
# SQLite location (inside the Docker volume mounted at /data).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for extra origins, e.g. Vercel preview deployments.
ALLOWED_ORIGIN_REGEX=
# true enables the X-Simulate-Failure test hook on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# LiteLLM cache: disk (persists under CACHE_DIR), local (in-memory) or none.
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400

DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=40
MAX_OUTPUT_TOKENS=4096
# A key that returns a real 429/401/403 is tried last for this many seconds.
KEY_COOLDOWN_SECONDS=30
# Per-client-IP limit on POST /chat (protects the key pool's quota). 0 disables.
RATE_LIMIT_PER_MINUTE=0
# Requests with a larger body are rejected with 413.
MAX_BODY_BYTES=65536
# Serve /docs (Swagger UI). Off by default so the API surface is exactly the contract.
ENABLE_DOCS=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend URL as seen by the browser (docker compose / runtime config).
FRONTEND_API_BASE_URL=http://localhost:8000
# Build-time fallback for static hosts such as Vercel/Netlify.
VITE_API_BASE_URL=http://localhost:8000
